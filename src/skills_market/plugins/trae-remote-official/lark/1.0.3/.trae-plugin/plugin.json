      "${connector.feishu.ACCESS_TOKEN}",
      "${connector.lark.ACCESS_TOKEN}"
    ],
    "LARKSUITE_CLI_BRAND": [
      "${connector.feishu.Provider}",
      "${connector.lark.Provider}"
    ],
    "LARKSUITE_CLI_APP_ID": [
      "${connector.feishu.CLIENT_ID}",
      "${connector.lark.CLIENT_ID}"
