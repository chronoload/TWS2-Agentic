{
  "scan_dirs": [
    "mcp"
  ],
  "strategy": "ts2",
  "endpoints": [
    "agent.py:Agent.chat",
    "agent.py:Agent._stage_llm_call",
    "agent.py:Agent._stage_tool_exec",
    "tools.py:get_tools",
    "team/team_tools.py:get_team_tools",
    "team/agent_team.py:AgentTeam",
    "team/team_runtime.py:AgentTeamsRuntime",
    "worktree.py:create_task_worktree",
    "worktree.py:remove_worktree",
    "middleware/command_guard.py:analyze_command",
    "middleware/command_guard.py:CommandGuardMiddleware",
    "subagent/coordinator.py:Coordinator.run_sequential",
    "subagent/coordinator.py:Coordinator.run_pipeline",
    "harness/hooks.py:CommandGuardHook",
    "runtime/run_manager.py:RunManager"
  ],
  "exclude": [
    "test",
    "tests",
    "__pycache__",
    "node_modules",
    ".git",
    "cache_data",
    "data",
    "docs",
    "skills"
  ]
}
