{
  "skill": {
    "name": "claw-shelllogger-enforcer",
    "version": "1.0.0",
    "description": "强制在 Claw 项目中使用 shell_logger.run()，否则拦截执行",
    "author": "Claw Project",
    "license": "Internal",
    "status": "active"
  },
  "target": {
    "workspace": "c:/Users/qu/WorkBuddy/Claw",
    "scope": "project-wide",
    "priority": "high"
  },
  "enforcement": {
    "mode": "strict",
    "auto_activate": true,
    "log_violations": true,
    "allow_queries": true,
    "audit_log": "Claw/logs/shelllogger_enforcer.log"
  },
  "exemptions": {
    "query_commands": [
      "tasklist",
      "Get-Process",
      "dir",
      "ls",
      "pwd",
      "which",
      "where",
      "echo",
      "findstr",
      "grep",
      "type",
      "cat",
      "find"
    ],
    "patterns": [
      "shell_logger.run(",
      "from shell_logger import run",
      "sync_log_to_wechat.py",
      "run_sync.py"
    ],
    "directories": []
  },
  "integration": {
    "with_security_guard": true,
    "with_network_guard": true,
    "execution_order": [
      "shell_logger_enforcer",
      "shell_logger.run()",
      "network_guard",
      "security_guard",
      "visible_runner"
    ]
  },
  "logging": {
    "format": "jsonl",
    "rotation": "daily",
    "retention": "90 days",
    "fields": [
      "timestamp",
      "check_result",
      "command",
      "reason",
      "context"
    ]
  },
  "actions_on_violation": {
    "log": true,
    "block_execution": true,
    "show_correction": true,
    "suggest_fix": true,
    "retry_allowed": true
  }
}
