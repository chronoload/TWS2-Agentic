    "category": "Productivity",
    "capabilities": [
      "Interactive",
      "Read",
      "Write"
    ],
    "websiteURL": "https://www.larksuite.com",
    "privacyPolicyURL": "https://www.larksuite.com/en_us/privacy-policy",
    "termsOfServiceURL": "https://www.larksuite.com/en_us/terms-of-service",
